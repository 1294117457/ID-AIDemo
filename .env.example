# 服务配置
PORT=3001
HOST=0.0.0.0

# PostgreSQL (关系型数据)
DATABASE_URL=postgresql://postgres:your_password@223.109.49.63:5432/agent

# pgvector (向量数据，使用同一个 PostgreSQL)
PG_VECTOR_URL=postgresql://postgres:your_password@223.109.49.63:5432/agent

# LangGraph Checkpoint
CHECKPOINT_ENABLED=true

# JWT (需要与后端一致)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# 后端服务
JAVA_BACKEND_URL=http://localhost:8080

# LLM (通义千问)
QWEN3_API_KEY=your_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3-max
QWEN_EMBEDDING_MODEL=text-embedding-v3

# 上下文压缩
CONTEXT_MAX_MESSAGES=20
